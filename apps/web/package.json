{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc",
    "test": "vp test run --passWithNoTests",
    "steiger": "steiger ./src",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@decision-experiments/web-ui": "workspace:*",
    "@effect/atom-react": "catalog:stack",
    "@r_masseater/injection-bisect": "workspace:*",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "catalog:stack",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "catalog:stack",
    "effect": "catalog:stack",
    "jose": "catalog:",
    "lucide-react": "catalog:stack",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0",
    "tailwindcss": "catalog:stack"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:stack",
    "@cloudflare/workers-types": "catalog:",
    "@decision-experiments/start-site": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@feature-sliced/steiger-plugin": "0.8.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "alchemy": "catalog:stack",
    "steiger": "catalog:stack",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
