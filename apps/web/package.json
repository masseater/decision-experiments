{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc",
    "test": "vp test run --passWithNoTests",
    "steiger": "steiger ./src",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:stack",
    "@injection-bisect/core": "workspace:*",
    "@tanstack/react-query": "catalog:stack",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "catalog:stack",
    "jose": "catalog:",
    "lucide-react": "catalog:stack",
    "radix-ui": "catalog:stack",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.28.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "catalog:stack",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:stack",
    "steiger": "catalog:stack",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
