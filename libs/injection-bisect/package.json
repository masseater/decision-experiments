{
  "name": "@r_masseater/injection-bisect",
  "version": "0.0.0",
  "description": "Find whether and where a prompt injection hides in text with fast, cheap decision models.",
  "keywords": [
    "effect",
    "llm",
    "openrouter",
    "prompt-injection",
    "security"
  ],
  "homepage": "https://github.com/masseater/injection-bisect#readme",
  "bugs": {
    "url": "https://github.com/masseater/injection-bisect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/injection-bisect.git",
    "directory": "libs/injection-bisect"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "prepublishOnly": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('npm publish leaves catalog: in dependencies. Publish the tarball from vp pm pack instead.'); process.exit(1) }\" && vp run build"
  },
  "dependencies": {
    "@effect/ai-openrouter": "catalog:",
    "effect": "catalog:stack",
    "parse5": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
