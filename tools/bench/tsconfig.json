{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner#ChildProcessSpawner",
          "effect/persistence/KeyValueStore",
          "effect/persistence/Persistable",
          "effect/persistence/PersistedCache",
          "effect/persistence/Persistence"
        ]
      }
    ]
  }
}
